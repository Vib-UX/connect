# BSC testnet (chain id 97) ConnectEscrow
CONNECT_ESCROW_CHAIN_ID=97
CONNECT_ESCROW_ADDRESS=
CONNECT_USDT_ADDRESS=
CONNECT_SHARE_ESCROW_ADDRESS=
CONNECT_NVDAB_ADDRESS=
CONNECT_XAUT_ADDRESS=
ESCROW_SETTLER=
ESCROW_SETTLER_PRIVATE_KEY=
BNB_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# Testnet amounts (18 decimals). Deposit 0.1, stake 0.001.
CONNECT_ESCROW_DEPOSIT_USDT=100000000000000000
CONNECT_ESCROW_STAKE_USDT=1000000000000000

# Cournot prepaid calls. The client reads this and does not require a saved key file.
COURNOT_API_KEY=

# CoinMarketCap Pro. Read by the relay only.
CMC_API_KEY=

# Living Brain. The relay reads prompts and does not keep the text. The key stays here.
LIVING_BRAIN_API_KEY=
# Subject UUID this key can act for. Required.
LIVING_BRAIN_SUBJECT_ID=
# Optional. The relay uses the Connect brain when this is empty.
LIVING_BRAIN_ID=
